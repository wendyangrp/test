# Copy this file to .env and fill in your own values.
# Never commit .env: it contains your secret API key.

# Your Anthropic API key (from https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional settings
# MODEL=claude-haiku-5-5
# PORT=3000
# RATE_LIMIT_PER_10_MIN=30
# Set to true only when running behind a hosting proxy that sets X-Forwarded-For
# TRUST_PROXY=false
